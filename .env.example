# Runtime Prisma queries use the shared transaction-mode pooler.
DATABASE_URL="postgresql://postgres:your-password@your-project-ref.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma migrations use the session-mode connection.
DIRECT_URL="postgresql://postgres:your-password@your-project-ref.pooler.supabase.com:5432/postgres"

# Supabase project settings. Keep the service role key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI-compatible provider settings. Never expose the API key in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4o-mini
DISCOVERY_SOURCE_URLS=https://example.com/vessel-source-1,https://example.com/vessel-source-2

WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_ACCESS_TOKEN=your-system-user-token
WHATSAPP_VERIFY_TOKEN=create-your-own-webhook-secret
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_DEFAULT_TIMEZONE=Africa/Lagos
WHATSAPP_AUTO_REPLY=false
WHATSAPP_ACK_TEMPLATE_NAME=primequest_intake_acknowledgement
WHATSAPP_ACK_TEMPLATE_LANGUAGE=en_US

# Optional: use another OpenAI-compatible provider endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
