# Prisma uses the same PostgreSQL connection as the Supabase project.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.phxemyqjgotknnewokfb:H36$000.com@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.phxemyqjgotknnewokfb:H36$000.com@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase project settings. Keep the service role key server-side only.
SUPABASE_URL=https://phxemyqjgotknnewokfb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI-compatible provider settings. Never expose the API key in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4o-mini
# Optional: use another OpenAI-compatible provider endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
